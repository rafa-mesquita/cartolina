{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cartolina-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // O site usa http://127.0.0.1:8787 por padrão: fixa o endereço do dev.
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "vars": { "ALLOWED_ORIGINS": "https://rafa-mesquita.github.io" },
  // Rate Limiting (opcional no código): se o plano grátis recusar, apague este bloco e o resto continua igual.
  "ratelimits": [
    { "name": "ROOM_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "GROUP_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cartolina",
      "database_id": "6965fbf3-8bf8-4982-9538-bfd08c964cd5",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }]
}
